---
/**
 * Screenshots and videos in the project window. Each item sits in a frame
 * (a browser window, a phone, or none) on an accent-tinted stage, with a
 * caption, arrows and dots below it. Swipe or scroll to move between items.
 *
 * The stage height comes from `--stage-h`, set by the parent so the window
 * shows everything down to "How it works" without scrolling.
 */
import Media from './Media.astro';
import Icon from './Icon.astro';
import type { Project } from '@/lib/projects';

type Item = NonNullable<Project['data']['cover']>;

interface Props {
  items: Item[];
  title: string;
  accent: string;
}

const { items, title, accent } = Astro.props;
/** Images and videos default to a browser window; embeds bring their own chrome. */
const frameOf = (m: Item) => m.frame ?? (m.type === 'image' || m.type === 'video' ? 'browser' : 'none');
---

<div class="show" data-show style={`--c: ${accent}`}>
  <div class="aura" aria-hidden="true"></div>
  <div class="stage">
    <div class="track" data-track>
      {
        items.map((m, i) => (
          <figure class="slide" data-caption={m.caption ?? ''}>
            <div class={`win ${frameOf(m)}`} style={m.aspect ? `--ar: ${m.aspect}` : undefined}>
              {frameOf(m) === 'browser' && (
                <span class="bar" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
              )}
              <Media item={m} title={title} accent={accent} mode="full" eager={i === 0} />
            </div>
          </figure>
        ))
      }
    </div>
  </div>

  <div class="under">
    <p class="cap" data-cap aria-live="polite">{items[0]?.caption}</p>
    {
      items.length > 1 && (
        <div class="ctrl">
          <button type="button" class="nav" data-go="-1" aria-label="Previous screenshot">
            <Icon name="arrow-left" size={16} />
          </button>
          <div class="dots">
            {items.map((m, i) => (
              <button type="button" class:list={['dot', { on: i === 0 }]} data-to={i} aria-label={`Show ${m.caption ?? `item ${i + 1}`}`} />
            ))}
          </div>
          <button type="button" class="nav" data-go="1" aria-label="Next screenshot">
            <Icon name="arrow-right" size={16} />
          </button>
        </div>
      )
    }
  </div>

  <dialog class="zoom" data-zoom aria-label="Enlarged screenshot">
    <img alt="" />
    <iframe title="" tabindex="-1" hidden></iframe>
  </dialog>
</div>

<script>
  function initShowcases() {
    document.querySelectorAll<HTMLElement>('[data-show]:not([data-ready])').forEach((show) => {
      show.dataset.ready = '';
      const track = show.querySelector<HTMLElement>('[data-track]')!;
      const slides = [...track.children] as HTMLElement[];
      const cap = show.querySelector<HTMLElement>('[data-cap]')!;
      const dots = [...show.querySelectorAll<HTMLButtonElement>('[data-to]')];
      const prev = show.querySelector<HTMLButtonElement>('[data-go="-1"]');
      const next = show.querySelector<HTMLButtonElement>('[data-go="1"]');

      const index = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      const go = (i: number) => track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      const sync = () => {
        const i = index();
        cap.textContent = slides[i]?.dataset.caption ?? '';
        dots.forEach((t, n) => t.classList.toggle('on', n === i));
        if (prev) prev.disabled = i === 0;
        if (next) next.disabled = i === slides.length - 1;
      };

      prev?.addEventListener('click', () => go(index() - 1));
      next?.addEventListener('click', () => go(index() + 1));
      dots.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.to))));
      track.addEventListener('scroll', sync, { passive: true });
      sync();

      // ← / → move between screenshots while focus is in here
      show.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        go(index() + (e.key === 'ArrowRight' ? 1 : -1));
      });

      // Click a screenshot to see it full size; click or Esc to close
      const zoom = show.querySelector<HTMLDialogElement>('[data-zoom]')!;
      const big = zoom.querySelector('img')!;
      const live = zoom.querySelector('iframe')!;
      track.querySelectorAll<HTMLImageElement>('img').forEach((img) =>
        img.addEventListener('click', () => {
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          big.hidden = false;
          live.hidden = true;
          zoom.showModal();
        }),
      );
      // A live demo takes no pointer events (so swipes move the gallery) and no focus; its frame
      // is the button: a click, Enter or Space opens a second copy of it, large, in the same dialog
      track.querySelectorAll<HTMLIFrameElement>('iframe.media').forEach((demo) => {
        const win = demo.closest<HTMLElement>('.win');
        if (!win) return;
        demo.tabIndex = -1;
        win.dataset.zoomable = '';
        win.tabIndex = 0;
        win.setAttribute('role', 'button');
        win.setAttribute('aria-label', `Enlarge demo: ${demo.title}`);
        const open = () => {
          live.style.setProperty('--ar', win.style.getPropertyValue('--ar') || '1.6');
          live.src = demo.src;
          live.title = demo.title;
          live.hidden = false;
          big.hidden = true;
          zoom.showModal();
        };
        win.addEventListener('click', open);
        win.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          e.preventDefault();
          open();
        });
      });
      // Stop the large copy when the dialog closes
      zoom.addEventListener('close', () => live.removeAttribute('src'));
      zoom.addEventListener('click', () => zoom.close());
      zoom.addEventListener('keydown', (e) => e.stopPropagation());
    });
  }
  document.addEventListener('astro:page-load', initShowcases);
</script>

<style>
  .show {
    position: relative;
    container-type: inline-size;
    /* Leave room for the caption row below the stage */
    --stage: min(var(--stage-h, 420px) - 3rem, 100cqw * 0.62 + 2rem);
  }

  /* The box, no outline */
  .stage {
    position: relative;
    height: var(--stage);
    border: 1px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--stage-bg);
  }

  /* A soft aura in the project colour around the box, slowly breathing */
  .aura {
    position: absolute;
    inset: 0 0 auto;
    height: var(--stage);
    border-radius: var(--radius);
    box-shadow: 0 30px 110px -30px color-mix(in oklab, var(--c) 52%, transparent);
    pointer-events: none;
    animation: breathe 9s ease-in-out infinite alternate;
  }
  @keyframes breathe {
    to {
      opacity: 0.55;
      transform: translateY(-8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aura {
      animation: none;
    }
  }
  /* Faint grid, as on the icon banners */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at center, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .track {
    position: relative;
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    display: grid;
    place-items: center;
    margin: 0;
    padding: clamp(0.9rem, 3cqw, 1.6rem) clamp(1rem, 7cqw, 4.5rem);
    scroll-snap-align: center;
    min-width: 0;
  }

  .win {
    --pad: clamp(0.9rem, 3cqw, 1.6rem);
    display: flex;
    flex-direction: column;
    max-width: 100%;
    overflow: hidden;
  }
  .show .win :global(.media) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    /* 4px: the frame's border and the box's border */
    max-height: calc(var(--stage) - var(--under, 0px) - 2 * var(--pad) - var(--bar, 0px) - 4px);
    object-fit: contain;
  }

  /* A browser window: dark title bar with three dots */
  .browser {
    --bar: 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--frame-line);
    background: var(--frame);
    box-shadow: 0 30px 70px -28px var(--shadow);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: var(--bar);
    padding-inline: 0.65rem;
    flex: none;
  }
  .bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--frame-dot);
  }

  /* A phone: rounded bezel */
  .phone {
    --bar: 12px;
    padding: 6px;
    border-radius: 26px;
    background: #0b0b0e;
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow: 0 30px 70px -28px rgb(0 0 0 / 0.9);
  }
  .show .win :global(img) {
    cursor: zoom-in;
  }
  .show .phone :global(.media) {
    border-radius: 20px;
  }

  /* A live demo (an embed). With an `aspect` it is sized as an image would be (in a browser
     frame, or a phone alone with no frame). Without one it fills the slide and fits itself in.
     No drop shadow: on an iframe Chrome draws it as a box around the whole frame.
     It takes no pointer events, so a swipe over it still moves the gallery. */
  .none:not([style*='--ar']):has(> :global(.media.frame)) {
    width: 100%;
    height: 100%;
  }
  .win[style*='--ar'] {
    width: min(100%, calc((var(--stage) - var(--under, 0px) - 2 * var(--pad) - var(--bar, 0px) - 4px) * var(--ar)));
  }
  .show .win :global(.media.frame) {
    width: 100%;
    height: 100%;
    max-height: none;
    aspect-ratio: auto;
    background: none;
    border-radius: 0;
    filter: none;
    pointer-events: none;
  }
  .show .win[style*='--ar'] :global(.media.frame) {
    height: auto;
    aspect-ratio: var(--ar);
  }

  /* No frame: the image already has its own shapes */
  .show .none :global(.media) {
    border-radius: 10px;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.6));
  }

  .ctrl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--glass);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      opacity 0.2s,
      border-color 0.2s;
  }
  .nav:hover {
    border-color: var(--text-dim);
  }
  .nav:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .under {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
    min-height: 2.25rem;
  }
  .cap {
    font-size: 0.85rem;
    color: var(--text-dim);
    min-width: 0;
  }
  .dots {
    display: flex;
    gap: 0.45rem;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--line-strong);
    cursor: pointer;
    transition:
      width 0.3s var(--ease),
      background 0.2s;
  }
  .dot:hover {
    background: var(--text-faint);
  }
  .dot.on {
    width: 1.5rem;
    background: var(--c);
  }

  .zoom {
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    overflow: hidden;
    cursor: zoom-out;
  }
  .zoom::backdrop {
    background: rgb(4 4 6 / 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .zoom [hidden] {
    display: none;
  }
  .show .win[data-zoomable] {
    cursor: zoom-in;
  }
  .show .win[data-zoomable]:focus-visible {
    outline: 2px solid var(--c);
    outline-offset: 3px;
  }
  .zoom iframe {
    display: block;
    width: min(96vw, calc(94vh * var(--ar)));
    height: auto;
    aspect-ratio: var(--ar);
    border: 0;
    background: none;
    pointer-events: none;
  }
  .zoom img {
    display: block;
    max-width: 96vw;
    max-height: 94vh;
    width: auto;
    height: auto;
  }

  /* Wider showcases: caption and dots float over the bottom of the stage,
     so the screenshot gets that height too */
  @container (min-width: 521px) {
    /* The caption bar gets its own strip at the bottom of the box, so the
       screenshot always sits above it and the arrows stay centred in it */
    .stage,
    .aura {
      --under: 3.25rem;
      --stage: min(var(--stage-h, 420px), (100cqw - 2rem) * 0.625 + 1.25rem + 1.3rem + 4px + var(--under));
    }
    .track {
      height: calc(100% - var(--under));
    }
    .under {
      position: absolute;
      left: 1px;
      right: 1px;
      bottom: 1px;
      height: 3.25rem; /* same as --under on .stage */
      margin: 0;
      min-height: 0;
      padding: 0 1rem;
      pointer-events: none;
    }
    .ctrl {
      pointer-events: auto;
    }
    .cap {
      color: var(--text);
    }
    /* A small gap under the screenshot too, so it never touches the caption strip */
    .slide {
      padding: 0.8rem 1rem 0.5rem;
    }
    .win {
      --pad: 0.65rem; /* counted twice: the 0.8rem above plus the 0.5rem below */
    }
  }


</style>
